# Maintainer: Omatype contributors

pkgname=omatype
pkgver=0.1.0
pkgrel=1
pkgdesc='Dead-simple typing speed test built with Qt Quick'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/omatype'
license=('MIT' 'OFL-1.1')
install='omatype.install'
depends=('qt6-base' 'qt6-declarative')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omatype "$pkgdir/usr/bin/omatype"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omatype.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omatype.svg"
  /usr/bin/install -Dm644 "$startdir/omatype.desktop" "$pkgdir/usr/share/applications/omatype.desktop"
}
